<Window x:Class="AstralWorkshop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Astral Workshop" Width="1200" Height="740" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#100D19" Foreground="#F2EBDD">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#CC252132"/><Setter Property="Foreground" Value="#F4E7C6"/><Setter Property="BorderBrush" Value="#88724A"/><Setter Property="Padding" Value="20,12"/><Setter Property="Margin" Value="5"/><Setter Property="FontSize" Value="15"/></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#1D1928"/><Setter Property="Foreground" Value="#F2EBDD"/><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#625572"/></Style>
</Window.Resources>
<Grid>
 <Grid.Background><ImageBrush ImageSource="background.png" Stretch="UniformToFill"/></Grid.Background>
 <Grid Background="#330B0711">
  <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition/><RowDefinition Height="185"/></Grid.RowDefinitions>
  <DockPanel Margin="28,20"><StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="Compendium" Click="Compendium_Click"/><Button Content="GitHub" Click="Github_Click"/></StackPanel><Button Content="Settings" DockPanel.Dock="Right" Click="Settings_Click" HorizontalAlignment="Right"/></DockPanel>
  <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="A S T R A L" FontFamily="Georgia" FontSize="68" Foreground="#E5CE91" HorizontalAlignment="Center"/><TextBlock Text="W O R K S H O P" FontFamily="Georgia" FontSize="27" Margin="0,14" HorizontalAlignment="Center"/><TextBlock Text="DIABLO II: RESURRECTED" FontSize="13" Foreground="#B5A9C5" HorizontalAlignment="Center"/></StackPanel>
  <Grid Grid.Row="2" Margin="45,10,45,30"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Bottom" Margin="0,0,30,10"><TextBlock x:Name="Status" Text="Choose your Diablo II: Resurrected folder in Settings." TextWrapping="Wrap" FontSize="16"/><TextBlock x:Name="VersionLabel" Margin="0,12,0,8" Foreground="#B5A9C5"/><ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="#D8B977" Background="#342B43"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Bottom"><Button x:Name="PlayButton" Content="Play" Height="72" FontSize="28" Click="Play_Click"/><Button x:Name="CancelButton" Content="Cancel update" Visibility="Collapsed" Click="Cancel_Click"/></StackPanel></Grid>
 </Grid>
 <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#F9100D19" Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <StackPanel Margin="20,30"><TextBlock Text="SETTINGS" FontSize="20" Foreground="#E5CE91" Margin="5,10,0,25"/><Button Content="Preferences" Click="Preferences_Click"/><Button Content="Game" Click="Game_Click"/><Button Content="About" Click="About_Click"/><Button Content="Close" Click="CloseSettings_Click" Margin="5,60,5,5"/></StackPanel>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="35"><StackPanel>
   <StackPanel x:Name="PreferencesPage"><TextBlock Text="Preferences" FontSize="30" Foreground="#E5CE91" Margin="0,0,0,30"/><TextBlock Text="Diablo II: Resurrected installation directory" Margin="0,0,0,12"/><TextBox x:Name="GamePath" IsReadOnly="True"/><StackPanel Orientation="Horizontal" Margin="0,12,0,25"><Button Content="Change directory" Click="Browse_Click"/><Button Content="Open directory" Click="OpenGame_Click"/></StackPanel><TextBlock Text="Updates are checked automatically whenever you press Play.&#10;Your saved characters and existing loader settings are preserved." TextWrapping="Wrap" FontSize="16" LineHeight="25"/><Button Content="Check and repair mod files" Click="Repair_Click" HorizontalAlignment="Left" Margin="0,30,0,0"/></StackPanel>
   <StackPanel x:Name="GamePage" Visibility="Collapsed"><TextBlock Text="Game" FontSize="30" Foreground="#E5CE91" Margin="0,0,0,30"/><TextBlock Text="Starts D2RLoader.exe with: -mod ReimaginedWorkshop -txt" TextWrapping="Wrap"/><TextBlock Text="Additional launch arguments" Margin="0,30,0,12"/><TextBox x:Name="Arguments"/><TextBlock Text="D2R and D2RLoader must already be installed in the selected folder." TextWrapping="Wrap" Margin="0,25"/><Button Content="Open saved characters" HorizontalAlignment="Left" Click="OpenSaves_Click"/></StackPanel>
   <StackPanel x:Name="AboutPage" Visibility="Collapsed"><TextBlock Text="About" FontSize="30" Foreground="#E5CE91" Margin="0,0,0,30"/><TextBlock Text="Astral Workshop Launcher Â· 0.1.0" FontSize="20"/><TextBlock Text="Official update repository: ZorunTzin/astral-workshop" Margin="0,25"/><Button Content="Open releases" Click="Releases_Click" HorizontalAlignment="Left"/><Button Content="Open launcher settings folder" Click="OpenSettings_Click" HorizontalAlignment="Left"/></StackPanel>
  </StackPanel></ScrollViewer>
 </Grid>
</Grid>
</Window>
